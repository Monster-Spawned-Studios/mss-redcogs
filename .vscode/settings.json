{
  // Copyright (c) 2025 Monster Spawned Studios | https://monsterspawned.studio | All Rights Reserved.
  "githubPullRequests.codingAgent.uiIntegration": true,
  "python.terminal.activateEnvironment": true,
  // Enable auto-formatting on save
  "editor.formatOnSave": true,
  // Enable auto-save feature
  "files.autoSave": "afterDelay",
  // Set the auto-save delay to 10000 milliseconds (10 seconds)
  "files.autoSaveDelay": 10000,
  // Use the Python extension to manage the virtual environment
  "python.envFile": "${workspaceFolder}/.env",
  // Set the current Python interpreter to the one in the .conda folder
  // This will ensure that the Python extension uses the correct interpreter for linting, debugging,
  // and running Python scripts.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  // Enable word-based suggestions
  "editor.wordBasedSuggestions": "matchingDocuments",
  // Disable the Python language server
  "python.languageServer": "None",
  // Set the default formatter to Black
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Add copyright information to the header of each file
  "files.insertFinalNewline": true,
  "turboFileHeader.autoInsertOnCreateFile": true,
  "turboFileHeader.autoUpdateOnSave": false,
  "turboFileHeader.companyName": "Monster Spawned Studios",
  "turboFileHeader.userName": "Monster Spawned Studios",
  "turboFileHeader.fileheader": [
    {
      "key": "filePath",
      "label": " * @file",
      "value": "{{filePath}}",
      "defaultValue": ""
    },
    {
      "key": "description",
      "label": " * @description",
      "value": "{{description}}",
      "defaultValue": ""
    },
    {
      "key": "authorName",
      "label": " * @author",
      "value": "{{authorName}} <{{authorEmail}}>",
      "usePrevious": true,
      "defaultValue": "Monster Spawned Studios <site-admin@monsterspawned.studio>"
    },
    {
      "key": "birthtime",
      "label": " * @createTime",
      "value": "{{birthtime}}",
      "usePrevious": true
    },
    {
      "key": "mtime",
      "label": " * @lastModified",
      "value": "{{mtime}}"
    },
    {
      "key": "copyright",
      "label": "@copyright",
      "value": "Copyright © {{birthtime}} Monster Spawned Studios | https://monsterspawned.studio | All Rights Reserved.",
      "wholeLine": true,
      "defaultValue": "Copyright © {{birthtime}} Monster Spawned Studios | https://monsterspawned.studio | All Rights Reserved."
    }
  ],
  "turboFileHeader.dateFormat": "MM-DD-YYYY HH:mm:ss",
  "turboFileHeader.userEmail": "site-admin@monsterspawned.studio",
  "editor.formatOnPaste": true,
  "prettier.useEditorConfig": true
}
