# EditorConfig is awesome: https://EditorConfig.org

root = true

[*.py]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
max_line_length = 150
trim_trailing_whitespace = true
insert_final_newline = true

[*.json]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
max_line_length = 150
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
max_line_length = 150
trim_trailing_whitespace = true
insert_final_newline = true

[*.yml]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
max_line_length = 150
trim_trailing_whitespace = true
insert_final_newline = true

[*.ini]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
max_line_length = 150
trim_trailing_whitespace = true
insert_final_newline = true

[*.sql]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
